# Pixel Play: server-side fallbacks. The recommended path is to leave these
# blank and use the in-app ⚙ Settings modal (key stays in browser localStorage).
# A key set here is only used when the request has no x-openai-key header.

# Pick a provider: openai (default) or replicate
PROVIDER=openai

# --- OpenAI ---------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-image-1
# OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Replicate ------------------------------------------------------------
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL=bytedance/sdxl-lightning-4step
